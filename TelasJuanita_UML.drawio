  <diagram id="m62h99PPUKxLtqlavbgh" name="Diagrama de clases">
    <mxGraphModel dx="2660" dy="1014" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\nskinparam classAttributeIconSize 0\nskinparam packageStyle rectangle\nskinparam shadowing false\n\ntitle DIAGRAMA DE CLASES\nsubtitle Sistema de Gestion Telas Juanita\n\npackage \&quot;Usuarios y clientes\&quot; {\n  class Rol {\n    - idRol: int\n    - nombre: String\n    - descripcion: String\n    + asignarPermisos()\n  }\n\n  class Usuario {\n    - idUsuario: int\n    - nombre: String\n    - apellido: String\n    - correo: String\n    - contrasena: String\n    - estado: String\n    + iniciarSesion()\n    + cerrarSesion()\n    + gestionarUsuarios()\n  }\n\n  class Cliente {\n    - idCliente: int\n    - nombre: String\n    - telefono: String\n    - direccion: String\n    - nit: String\n    + registrarCliente()\n    + actualizarDatos()\n    + consultarHistorial()\n  }\n}\n\npackage \&quot;Catalogo e inventario\&quot; {\n  class CategoriaTela {\n    - idCategoria: int\n    - nombre: String\n    - descripcion: String\n    + registrarCategoria()\n    + modificarCategoria()\n  }\n\n  class Tela {\n    - idTela: int\n    - nombre: String\n    - descripcion: String\n    - color: String\n    - tipo: String\n    - precioMetro: Decimal\n    - stockMetros: Decimal\n    + registrarTela()\n    + actualizarPrecio()\n    + consultarStock()\n  }\n\n  class MovimientoInventario {\n    - idMovimiento: int\n    - fecha: Date\n    - tipoMovimiento: String\n    - cantidadMetros: Decimal\n    - motivo: String\n    + registrarMovimiento()\n    + actualizarStock()\n  }\n}\n\npackage \&quot;Ventas y pagos\&quot; {\n  class Venta {\n    - idVenta: int\n    - fecha: Date\n    - total: Decimal\n    - estado: String\n    + registrarVenta()\n    + calcularTotal()\n    + anularVenta()\n  }\n\n  class DetalleVenta {\n    - idDetalleVenta: int\n    - cantidadMetros: Decimal\n    - precioUnitario: Decimal\n    - subtotal: Decimal\n    + calcularSubtotal()\n  }\n\n  class Pago {\n    - idPago: int\n    - fecha: Date\n    - monto: Decimal\n    - metodoPago: String\n    + registrarPago()\n    + consultarPago()\n  }\n\n  class Credito {\n    - idCredito: int\n    - montoTotal: Decimal\n    - saldoPendiente: Decimal\n    - fechaVencimiento: Date\n    - estado: String\n    + calcularSaldo()\n    + registrarAbono()\n  }\n\n  class Cobro {\n    - idCobro: int\n    - fecha: Date\n    - monto: Decimal\n    - observacion: String\n    + registrarCobro()\n  }\n\n  class Devolucion {\n    - idDevolucion: int\n    - fecha: Date\n    - motivo: String\n    - total: Decimal\n    - estado: String\n    + registrarDevolucion()\n    + procesarDevolucion()\n  }\n\n  class DetalleDevolucion {\n    - idDetalleDevolucion: int\n    - cantidadMetros: Decimal\n    - monto: Decimal\n    - observacion: String\n  }\n}\n\npackage \&quot;Pedidos y reservas\&quot; {\n  class Pedido {\n    - idPedido: int\n    - fecha: Date\n    - fechaEntrega: Date\n    - estado: String\n    - total: Decimal\n    + registrarPedido()\n    + confirmarPedido()\n    + cancelarPedido()\n  }\n\n  class DetallePedido {\n    - idDetallePedido: int\n    - cantidadMetros: Decimal\n    - precioUnitario: Decimal\n    - subtotal: Decimal\n    + calcularSubtotal()\n  }\n}\n\npackage \&quot;Proveedores y compras\&quot; {\n  class Proveedor {\n    - idProveedor: int\n    - nombre: String\n    - telefono: String\n    - direccion: String\n    - nit: String\n    + registrarProveedor()\n    + actualizarProveedor()\n  }\n\n  class Compra {\n    - idCompra: int\n    - fecha: Date\n    - total: Decimal\n    - estado: String\n    + registrarCompra()\n    + calcularTotal()\n  }\n\n  class DetalleCompra {\n    - idDetalleCompra: int\n    - cantidadMetros: Decimal\n    - costoUnitario: Decimal\n    - subtotal: Decimal\n    + calcularSubtotal()\n  }\n}\n\npackage \&quot;Administracion\&quot; {\n  class CierreCaja {\n    - idCierre: int\n    - fecha: Date\n    - totalVentas: Decimal\n    - totalEfectivo: Decimal\n    - totalOtrosPagos: Decimal\n    - diferencia: Decimal\n    + generarCierre()\n    + calcularTotales()\n  }\n\n  class RegistroAuditoria {\n    - idRegistro: int\n    - fecha: Date\n    - accion: String\n    - descripcion: String\n    + registrarAccion()\n  }\n}\n\n&#39; Relaciones de usuarios y clientes\nRol \&quot;1\&quot; -- \&quot;0..*\&quot; Usuario : asigna\nUsuario \&quot;1\&quot; -- \&quot;0..*\&quot; Venta : registra\nCliente \&quot;1\&quot; -- \&quot;0..*\&quot; Venta : realiza\n\n&#39; Relaciones del catalogo e inventario\nCategoriaTela \&quot;1\&quot; -- \&quot;0..*\&quot; Tela : clasifica\nTela \&quot;1\&quot; -- \&quot;0..*\&quot; MovimientoInventario : registra\nUsuario \&quot;1\&quot; -- \&quot;0..*\&quot; MovimientoInventario : controla\n\n&#39; Relaciones de ventas y pagos\nVenta \&quot;1\&quot; *-- \&quot;1..*\&quot; DetalleVenta : contiene\nTela \&quot;1\&quot; -- \&quot;0..*\&quot; DetalleVenta : corresponde\nVenta \&quot;1\&quot; -- \&quot;0..*\&quot; Pago : recibe\nVenta \&quot;1\&quot; -- \&quot;0..1\&quot; Credito : genera\nCredito \&quot;1\&quot; -- \&quot;0..*\&quot; Cobro : registra\nVenta \&quot;1\&quot; -- \&quot;0..*\&quot; Devolucion : puede tener\nDevolucion \&quot;1\&quot; *-- \&quot;1..*\&quot; DetalleDevolucion : contiene\nDetalleVenta \&quot;1\&quot; -- \&quot;0..*\&quot; DetalleDevolucion : referencia\nUsuario \&quot;1\&quot; -- \&quot;0..*\&quot; Devolucion : gestiona\n\n&#39; Relaciones de pedidos\nCliente \&quot;1\&quot; -- \&quot;0..*\&quot; Pedido : realiza\nPedido \&quot;1\&quot; *-- \&quot;1..*\&quot; DetallePedido : contiene\nTela \&quot;1\&quot; -- \&quot;0..*\&quot; DetallePedido : corresponde\n\n&#39; Relaciones de compras\nProveedor \&quot;1\&quot; -- \&quot;0..*\&quot; Compra : suministra\nUsuario \&quot;1\&quot; -- \&quot;0..*\&quot; Compra : registra\nCompra \&quot;1\&quot; *-- \&quot;1..*\&quot; DetalleCompra : contiene\nTela \&quot;1\&quot; -- \&quot;0..*\&quot; DetalleCompra : corresponde\n\n&#39; Relaciones administrativas\nUsuario \&quot;1\&quot; -- \&quot;0..*\&quot; CierreCaja : realiza\nUsuario \&quot;1\&quot; -- \&quot;0..*\&quot; RegistroAuditoria : genera\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tS9QlGUB6NhDaKSp1fqg-763">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
